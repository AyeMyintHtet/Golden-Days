# Public settings: VITE_ variables are visible in the browser, never secrets.
VITE_MEDIA_URL=/api/album
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/goldendays/
VITE_AUTH_REQUIRED=true

# Server only. Put real values in .env.local and Vercel project environment settings.
# Never prefix these with VITE_. Do not commit or paste keys into chat.
IMAGEKIT_PRIVATE_KEY=
# Use at least 16 characters for the shared family password.
ALBUM_PASSWORD=
# Use at least 32 random characters; rotating this signs out every device.
ALBUM_SESSION_SECRET=
