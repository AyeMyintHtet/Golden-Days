# Vite assets have content hashes, so long-lived public caching is safe.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Keep media caching on the visitor's device, not in a shared proxy cache.
/images/*
  Cache-Control: private, max-age=86400

# Let browsers check for new app versions instead of retaining an old worker.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

/icons/*
  Cache-Control: public, max-age=86400
