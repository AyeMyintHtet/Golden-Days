{
  "name": "golden-days",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pwa": "vite --port 5174 --strictPort --mode pwa",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sw.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test:security": "node --import tsx --test tests/album-security.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "media:thumbnails": "node scripts/create-thumbnails.mjs",
    "media:index": "node scripts/create-media-index.mjs",
    "pwa:icons": "node scripts/create-app-icons.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.0",
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/noto-sans-myanmar": "^5.3.0",
    "@imagekit/nodejs": "^7.15.0",
    "@imagekit/react": "^5.0.3",
    "fflate": "^0.8.3",
    "i18next": "^27.2.6",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^18.0.3",
    "three": "^0.187.0",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-range-requests": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  }
}
